generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DENTIST
  LAB_TECH
  ADMIN
  FINANCIAL
  SELLER
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum CaseStatus {
  DRAFT
  SUBMITTED
  IN_PLANNING
  IN_MOVEMENT
  LAB_APPROVAL
  WAITING_APPROVAL
  REVISION_REQUESTED
  APPROVED
  PRINTING_3D
  LABORATORY
  EXPEDITION
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  REFINEMENT
}

enum ProductType {
  ALINHADORES
  FINALIZACAO
  PLACA_MIORRELAXANTE
  EA_AIR2
}

enum DocumentType {
  PHOTO_EXTRA
  PHOTO_INTRA
  STL_UPPER
  STL_LOWER
  XRAY_PANORAMIC
  XRAY_CEPHALOMETRIC
  SETUP
  OTHER
}

enum PaymentProvider {
  REDE
  SAUDE_SERVICE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PushTargetType {
  ALL
  ROLE
  USER
  SELLER_PORTFOLIO
}

enum PushLevel {
  INFO
  WARNING
  URGENT
}

enum AppModuleStatus {
  ACTIVE
  INACTIVE
}

model User {
  id                  String     @id @default(uuid())
  name                String
  email               String     @unique
  password            String
  role                Role       @default(DENTIST)
  status              UserStatus @default(PENDING)
  cro                 String?
  clinic              String?
  cnpj                String?
  phone               String?
  address             String?
  city                String?
  state               String?
  zipCode             String?
  country             String?    @default("BR")
  deliveryStreet      String?
  deliveryNumber      String?
  deliveryComplement  String?
  deliveryNeighborhood String?
  deliveryCity        String?
  deliveryState       String?
  deliveryZip         String?
  deliveryPhone       String?
  deliveryMobile      String?
  totvsCode           String?
  totvsChave          String?
  totvsLoja           String?
  totvsProteusClient  String?
  firstCaseCouponEligible Boolean @default(false)
  emailVerified       Boolean    @default(false)
  emailVerifyToken    String?
  resetPasswordToken  String?
  resetPasswordExpiry DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  cases               Case[]     @relation("DentistCases")
  patients            Patient[]  @relation("DentistPatients")
  plannings           Planning[] @relation("LabTechPlannings")
  revisions           Revision[] @relation("RevisionRequester")
  payments            Payment[]
  notifications       Notification[]
  pushReads           PushRead[]
  pushNotifications   PushNotification[] @relation("PushCreator")
  emailLogs           EmailLog[]
  sellerClients       SellerClient[] @relation("SellerRelation")
  clientSellers       SellerClient[] @relation("ClientRelation")
  sentMessages        ChatMessage[]  @relation("ChatSent")
  receivedMessages    ChatMessage[]  @relation("ChatReceived")
  financials          Financial[]    @relation("BilledBy")
  planningForms       PlanningForm[] @relation("DentistPlanningForms")
  completionForms     CompletionForm[] @relation("DentistCompletionForms")
  otherServicesForms  OtherServicesForm[] @relation("DentistOtherServicesForms")
  clinicalRecords     ClinicalRecord[] @relation("DentistClinicalRecords")
  workflowEvents      WorkflowEvent[] @relation("WorkflowEventPerformer")
  dentistInvoices     DentistInvoice[] @relation("DentistInvoices")
}

model Case {
  id               String      @id @default(uuid())
  caseNumber       Int         @default(autoincrement())
  dentistId        String
  patientId        String?
  serviceId        String?
  productType      ProductType?
  patientName      String
  patientDob       DateTime?
  gender           String?
  notes            String?
  planningFormData Json?
  status           CaseStatus  @default(DRAFT)
  billingType      String?
  installmentOption String?
  dropoutInsurance Boolean     @default(false)
  discountCoupon   String?
  packActive       Boolean     @default(false)
  totvsOrderId     String?
  isRefinement     Boolean     @default(false)
  parentCaseId     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  dentist          User        @relation("DentistCases", fields: [dentistId], references: [id])
  patient          Patient?    @relation(fields: [patientId], references: [id])
  service          Service?    @relation(fields: [serviceId], references: [id])
  parentCase       Case?       @relation("CaseRefinements", fields: [parentCaseId], references: [id])
  refinements      Case[]      @relation("CaseRefinements")
  documents        CaseDocument[]
  plannings        Planning[]
  production       Production?
  payment          Payment?
  financial        Financial?
  activities       CaseActivity[]
  emailLogs        EmailLog[]
  workflowEvents   WorkflowEvent[]
}

model Patient {
  id        String    @id @default(uuid())
  name      String
  gender    String?
  dob       DateTime?
  dentistId String
  active    Boolean   @default(true)
  importantNotes String?
  teethData Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  dentist            User               @relation("DentistPatients", fields: [dentistId], references: [id])
  cases              Case[]
  photos             Photo[]
  digitalModels      DigitalModel[]
  workFiles          WorkFile[]
  planningForms      PlanningForm[]
  completionForms    CompletionForm[]
  otherServicesForms OtherServicesForm[]
  clinicalRecords    ClinicalRecord[]
}
model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  description   String?
  type          String   // 'PERCENT' ou 'AMOUNT'
  value         Float
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model CaseDocument {
  id         String       @id @default(uuid())
  caseId     String
  type       DocumentType
  fileName   String
  url        String
  size       Int
  uploadedAt DateTime     @default(now())

  case       Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Planning {
  id              String    @id @default(uuid())
  caseId          String
  labTechId       String
  notes           String?
  alignerUpper    Int?
  alignerLower    Int?
  setupUrl        String?
  setupFileName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  case            Case      @relation(fields: [caseId], references: [id])
  labTech         User      @relation("LabTechPlannings", fields: [labTechId], references: [id])
  revisions       Revision[]
}

model Revision {
  id           String    @id @default(uuid())
  planningId   String
  requestedBy  String
  notes        String
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())

  planning     Planning  @relation(fields: [planningId], references: [id])
  requester    User      @relation("RevisionRequester", fields: [requestedBy], references: [id])
}

model Production {
  id           String    @id @default(uuid())
  caseId       String    @unique
  trackingCode String?
  carrier      String?
  shippedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  case         Case      @relation(fields: [caseId], references: [id])
}

model Service {
  id              String   @id @default(uuid())
  name            String
  description     String?
  type            String
  productionDays  Int      @default(15)
  maxRevisions    Int      @default(2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  prices          Price[]
  cases           Case[]
}

model Price {
  id          String   @id @default(uuid())
  serviceId   String
  price       Decimal  @db.Decimal(10, 2)
  groupId     String?
  dentistId   String?
  validFrom   DateTime @default(now())
  createdAt   DateTime @default(now())

  service     Service  @relation(fields: [serviceId], references: [id])
}

model Payment {
  id            String          @id @default(uuid())
  caseId        String          @unique
  dentistId     String
  provider      PaymentProvider
  amount        Decimal         @db.Decimal(10, 2)
  status        PaymentStatus   @default(PENDING)
  transactionId String?
  paidAt        DateTime?
  metadata      Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  case          Case            @relation(fields: [caseId], references: [id])
  dentist       User            @relation(fields: [dentistId], references: [id])
}

model Financial {
  id            String    @id @default(uuid())
  caseId        String    @unique
  invoiceNumber String?
  billedAt      DateTime?
  billedById    String?
  amount        Decimal?  @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime  @default(now())

  case          Case      @relation(fields: [caseId], references: [id])
  billedBy      User?     @relation("BilledBy", fields: [billedById], references: [id])
}

model SellerClient {
  sellerId   String
  clientId   String
  createdAt  DateTime @default(now())

  seller     User     @relation("SellerRelation", fields: [sellerId], references: [id])
  client     User     @relation("ClientRelation", fields: [clientId], references: [id])

  @@id([sellerId, clientId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushNotification {
  id          String         @id @default(uuid())
  createdById String
  title       String
  body        String
  link        String?
  level       PushLevel      @default(INFO)
  targetType  PushTargetType @default(ALL)
  targetId    String?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())

  createdBy   User           @relation("PushCreator", fields: [createdById], references: [id])
  reads       PushRead[]
}

model PushRead {
  id       String           @id @default(uuid())
  pushId   String
  userId   String
  readAt   DateTime         @default(now())

  push     PushNotification @relation(fields: [pushId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pushId, userId])
}

model AppModule {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  icon        String?
  url         String
  roles       Role[]
  status      AppModuleStatus @default(ACTIVE)
  openInNewTab Boolean        @default(false)
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CaseActivity {
  id          String   @id @default(uuid())
  caseId      String
  userId      String?
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id         String   @id @default(uuid())
  caseId     String?
  userId     String?
  event      String
  recipients String[]
  subject    String
  status     String   @default("SENT")
  error      String?
  sentAt     DateTime @default(now())

  case       Case?    @relation(fields: [caseId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

model TotvsLog {
  id         String   @id @default(uuid())
  direction  String
  endpoint   String
  payload    Json?
  response   Json?
  status     String
  createdAt  DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Photo {
  id        String   @id @default(uuid())
  patientId String
  url       String
  filename  String
  size      Int?
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())

  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model DigitalModel {
  id        String   @id @default(uuid())
  patientId String
  url       String
  filename  String
  size      Int?
  kind      String
  createdAt DateTime @default(now())

  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model WorkFile {
  id        String   @id @default(uuid())
  patientId String
  url       String
  filename  String
  size      Int?
  createdAt DateTime @default(now())

  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PlanningForm {
  id        String   @id @default(uuid())
  patientId String
  dentistId String
  formData  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient   Patient  @relation(fields: [patientId], references: [id])
  dentist   User     @relation("DentistPlanningForms", fields: [dentistId], references: [id])
}

model CompletionForm {
  id              String   @id @default(uuid())
  patientId       String
  dentistId       String
  formData        Json
  contentionUpper Int?
  contentionLower Int?
  observations    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient         Patient  @relation(fields: [patientId], references: [id])
  dentist         User     @relation("DentistCompletionForms", fields: [dentistId], references: [id])
}

model OtherServicesForm {
  id           String   @id @default(uuid())
  patientId    String
  dentistId    String
  eaGuard      Boolean  @default(false)
  eaSplint     Boolean  @default(false)
  eaMio        String?
  eaAir        Boolean  @default(false)
  observations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient      Patient  @relation(fields: [patientId], references: [id])
  dentist      User     @relation("DentistOtherServicesForms", fields: [dentistId], references: [id])
}

model ClinicalRecord {
  id             String   @id @default(uuid())
  patientId      String
  dentistId      String
  consultationAt DateTime
  evaluation     String
  activities     String[]
  observations   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        Patient  @relation(fields: [patientId], references: [id])
  dentist        User     @relation("DentistClinicalRecords", fields: [dentistId], references: [id])
}

model WorkflowEvent {
  id          String   @id @default(uuid())
  caseId      String
  stage       Int
  stageName   String
  performedBy String?
  notes       String?
  createdAt   DateTime @default(now())

  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  performer   User?    @relation("WorkflowEventPerformer", fields: [performedBy], references: [id])
}

enum VideoCategory {
  VIDEO_AULA
  WEBINAR
}

model Video {
  id          String        @id @default(uuid())
  title       String
  description String?
  vimeoUrl    String
  category    VideoCategory
  thumbnail   String?
  order       Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ContentPage {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  body        String?
  fileUrl     String?
  fileName    String?
  fileMime    String?
  fileData    Bytes?
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model DentistInvoice {
  id            String   @id @default(uuid())
  dentistId     String
  caseId        String?
  totvsId       String?  @unique
  invoiceNumber String
  description   String
  amount        Decimal  @db.Decimal(10, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        String   @default("OPEN")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dentist       User     @relation("DentistInvoices", fields: [dentistId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender     User     @relation("ChatSent", fields: [senderId], references: [id])
  receiver   User     @relation("ChatReceived", fields: [receiverId], references: [id])
}

model InvoicePayment {
  id            String   @id @default(uuid())
  dentistId     String
  invoiceIds    String[]
  totalAmount   Decimal  @db.Decimal(10, 2)
  method        String
  status        String   @default("PENDING")
  pixCode       String?
  pixExpiry     DateTime?
  cardLast4     String?
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
