# ────── Banco de dados
DATABASE_URL="postgresql://ortholab:ortholab123@localhost:5432/ortholab_db"

# ────── JWT (gerar segredos com: openssl rand -hex 64)
# Em produção: mínimo 32 caracteres e DIFERENTES entre access/refresh
JWT_SECRET="change-me-min-32-chars-access-secret-aaaaaaaaaaaaaaaaaaaa"
JWT_REFRESH_SECRET="change-me-min-32-chars-refresh-secret-bbbbbbbbbbbbbbb"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ────── Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ────── Seed admin (obrigatório em produção; senha será solicitada para troca no primeiro login)
SEED_ADMIN_PASSWORD=

# ────── S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ortholab
S3_SECRET_KEY=ortholab123
S3_BUCKET=ortholab-files
S3_REGION=us-east-1

# ────── Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@estheticaligner.com.br
SMTP_PASS=your-email-password
SMTP_FROM="Esthetic Aligner <noreply@estheticaligner.com.br>"

# ────── App URL (link de reset de senha aponta para FRONTEND)
APP_URL=https://ortholab.estheticaligner.com.br

# ────── Pagamento — Rede
REDE_PV=your-rede-pv
REDE_TOKEN=your-rede-token
REDE_ENV=sandbox

# Segredo HMAC-SHA256 que valida POSTs em /api/payments/webhook/:provider
# OBRIGATÓRIO em produção (mínimo 16 chars). Rotacionar periodicamente.
PAYMENT_WEBHOOK_SECRET=

# PIX via Rede — Authorization Basic esperado em /api/dentist-financial/webhooks/pix
# OBRIGATÓRIO em produção. Sem valor, o endpoint responde 503 em prod.
# Gerar com: echo -n "$REDE_PV:$REDE_TOKEN" | base64 e prefixar com "Basic "
REDE_WEBHOOK_AUTH=

# ────── Pagamento — Saude Service
SAUDE_SERVICE_URL=https://api.saudeservice.com.br
SAUDE_SERVICE_KEY=your-saude-service-key

# ────── PIX estático (opcional — fallback BR Code)
PIX_KEY=
PIX_MERCHANT_NAME=ESTHETIC ALIGNER
PIX_MERCHANT_CITY=SAO PAULO

# ────── Integração TOTVS
TOTVS_ENABLED=false
TOTVS_BASE_URL=https://your-totvs-instance.com
TOTVS_API_KEY=your-totvs-api-key
TOTVS_WEBHOOK_SECRET=your-webhook-secret
